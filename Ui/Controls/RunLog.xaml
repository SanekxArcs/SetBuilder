<UserControl x:Class="TunerFest.Ui.Controls.RunLog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TunerFest.Ui.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <!-- Run log: header row with follow toggle, copy, clear and font size; a read-only FlowDocument with one coloured line per event. -->
  <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="14,8,10,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="ЖУРНАЛ ЗАПУСКУ" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ui:ToggleSwitch x:Name="Follow" Grid.Column="1" Content="Стежити" IsChecked="True" VerticalAlignment="Center"
                         AutomationProperties.Name="Стежити" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="Копіювати" Icon="{ui:SymbolIcon Copy24}" Appearance="Secondary" Padding="10,4" Margin="0,0,6,0"
                     Click="OnCopy" />
          <ui:Button Content="Очистити екран" Icon="{ui:SymbolIcon Broom24}" Appearance="Secondary" Padding="10,4" Margin="0,0,6,0"
                     Click="OnClear" />
          <ui:Button Content="A−" Appearance="Secondary" Width="42" Padding="4" Margin="0,0,4,0" Click="OnFontDown"
                     ToolTip="Менший шрифт журналу" />
          <ui:Button Content="A+" Appearance="Secondary" Width="42" Padding="4" Margin="0,0,6,0" Click="OnFontUp"
                     ToolTip="Більший шрифт журналу" />
          <ui:Button x:Name="CollapseButton" Appearance="Transparent" Padding="6,4" Click="OnToggleCollapsed"
                     ToolTip="Згорнути журнал" Icon="{ui:SymbolIcon ChevronDown24}" />
        </StackPanel>
      </Grid>

      <RichTextBox x:Name="Events" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="False" IsUndoEnabled="False"
                   BorderThickness="0" Background="Transparent" Padding="10,0,10,8" Margin="4,0,4,4"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   AutomationProperties.Name="Журнал запуску">
        <RichTextBox.Resources>
          <Style TargetType="Paragraph">
            <Setter Property="Margin" Value="0,0,0,1" />
          </Style>
        </RichTextBox.Resources>
        <FlowDocument x:Name="Document" PagePadding="0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14.67" />
      </RichTextBox>
    </Grid>
  </Border>
</UserControl>
