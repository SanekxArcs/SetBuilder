<ui:FluentWindow x:Class="TunerFest.Ui.Shell.OverlayWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:TunerFest.Ui"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
                 Title="Set Builder · накладка"
                 Width="300" MinWidth="180" SizeToContent="Height" MinHeight="0"
                 WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
                 ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Acrylic" WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 AutomationProperties.Name="Накладка Set Builder">
  <ui:FluentWindow.Resources>
    <!-- Same dot colours as the status card. -->
    <Style x:Key="OverlayDot" TargetType="Ellipse">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Current}" Value="Countdown">
          <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="Running">
          <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="Paused">
          <Setter Property="Fill" Value="#FFA726" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="Done">
          <Setter Property="Fill" Value="#86DAA4" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="Failed">
          <Setter Property="Fill" Value="#FF6B6B" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="Stopped">
          <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="OverlayClock" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsClockVisible}" Value="False">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="Paused">
          <Setter Property="Foreground" Value="#FFA726" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Buttons never take keyboard focus: the game keeps it. -->
    <Style x:Key="OverlayButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid x:Name="Root">
    <!-- Tint under the content so the text stays readable over any game frame, with or without Acrylic. -->
    <Border Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.86" />
    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
    <Grid Margin="12,8,10,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 1. Status: dot, title, clock, hide. -->
      <Grid DataContext="{Binding Status}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Style="{StaticResource OverlayDot}" VerticalAlignment="Center" Margin="0,1,8,0" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Grid.Column="2" Style="{StaticResource OverlayClock}" Text="{Binding Clock}" Margin="8,0,4,0"
                   FontFamily="Segoe UI Variable Display, Segoe UI" />
        <ui:Button Grid.Column="3" Appearance="Transparent" Padding="4" Width="26" Height="26" Focusable="False"
                   Icon="{ui:SymbolIcon Dismiss24}" Click="OnHide" ToolTip="Сховати накладку (Сповіщення → Накладка поверх гри)"
                   AutomationProperties.Name="Сховати накладку" />
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding Status.Detail}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                 MaxHeight="32" Margin="0,1,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

      <!-- 2. Start · Pause · Stop. -->
      <WrapPanel Grid.Row="2" Margin="0,8,0,0">
        <ui:Button Style="{StaticResource OverlayButton}" Content="Почати" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                   Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" ToolTip="Почати · F8"
                   AutomationProperties.Name="Почати" />
        <ui:Button Style="{StaticResource OverlayButton}" Content="{Binding PauseLabel}" Appearance="Secondary"
                   Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}"
                   ToolTip="Зупинити натискання перед наступним читанням екрана; «Продовжити» відновлює запуск"
                   AutomationProperties.Name="Пауза">
          <ui:Button.Icon>
            <ui:SymbolIcon Symbol="{Binding PauseIcon}" />
          </ui:Button.Icon>
        </ui:Button>
        <ui:Button Style="{StaticResource OverlayButton}" Content="Зупинити" Icon="{ui:SymbolIcon Stop24}" Appearance="Secondary"
                   Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" ToolTip="Зупинити · F10" Margin="0"
                   AutomationProperties.Name="Зупинити" />
      </WrapPanel>

      <!-- 3. Last log line. -->
      <TextBlock Grid.Row="3" Text="{Binding StatusLine}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                 MaxHeight="32" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 AutomationProperties.Name="Останній рядок журналу" />
    </Grid>
  </Grid>
</ui:FluentWindow>
