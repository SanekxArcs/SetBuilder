<UserControl x:Class="TunerFest.Ui.Pages.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TunerFest.Ui.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:NotificationsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Text="Сповіщення" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Дізнайся, коли сет готовий, робота зупинилась або чекає на фокус гри." Style="{StaticResource CardDescription}" />

      <TextBlock Text="Сповіщення" Style="{StaticResource SectionHeader}" />

      <ui:CardControl Icon="{ui:SymbolIcon AlertOn24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Сповіщення Windows у кутку екрана: готово, зупинка, пауза" Style="{StaticResource CardTitle}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding ToastEnabled, Mode=TwoWay}" />
      </ui:CardControl>

      <TextBlock Text="Звукові сигнали" Style="{StaticResource SectionHeader}" />

      <ui:CardControl Icon="{ui:SymbolIcon MusicNote224}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Коли всі деталі готові" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Сигнал після того, як усі деталі сету зібрані." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:ToggleSwitch IsChecked="{Binding CompletionSoundEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
          <ComboBox Width="220" Margin="16,0,0,0" ItemsSource="{Binding Tones}" DisplayMemberPath="Title" SelectedValuePath="Code"
                    SelectedValue="{Binding CompletionSound, Mode=TwoWay}" IsEnabled="{Binding CompletionToneEnabled}" />
          <ui:Button Content="Прослухати" Icon="{ui:SymbolIcon Speaker224}" Margin="8,0,0,0" Command="{Binding PreviewCompletionCommand}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon MusicNote224}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="При зупинці або помилці" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Сигнал, коли робота зупинилась сама, через F10 або через помилку." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:ToggleSwitch IsChecked="{Binding StopSoundEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
          <ComboBox Width="220" Margin="16,0,0,0" ItemsSource="{Binding Tones}" DisplayMemberPath="Title" SelectedValuePath="Code"
                    SelectedValue="{Binding StopSound, Mode=TwoWay}" IsEnabled="{Binding StopToneEnabled}" />
          <ui:Button Content="Прослухати" Icon="{ui:SymbolIcon Speaker224}" Margin="8,0,0,0" Command="{Binding PreviewStopCommand}" />
        </StackPanel>
      </ui:CardControl>

      <TextBlock Text="Власні мелодії працюють незалежно від системної звукової схеми. Гучність Set Builder можна змінити у мікшері Windows. PNG та зчитування екрана — без сигналу."
                 Style="{StaticResource CardDescription}" Margin="2,8,0,0" />

      <TextBlock Text="Застосунок" Style="{StaticResource SectionHeader}" />

      <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}" Margin="0,0,0,4">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Тема вікна" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Системна — як у Windows; темна або світла — завжди." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox Width="220" ItemsSource="{x:Static vm:NotificationsViewModel.ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding Theme, Mode=TwoWay}" />
      </ui:CardControl>

      <TextBlock Text="{Binding VersionLine, Mode=OneWay}" Style="{StaticResource CardDescription}" Margin="2,16,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
