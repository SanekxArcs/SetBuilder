<UserControl x:Class="TunerFest.Ui.Pages.TemplatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TunerFest.Ui.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:TemplateViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <!-- Reference page showing the conventions every page follows. The shell agent deletes it once the real pages exist. -->
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Text="Шаблон сторінки" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Кожна сторінка: заголовок, секції з картками, опис під назвою кожного параметра." Style="{StaticResource CardDescription}" />

      <TextBlock Text="Секція" Style="{StaticResource SectionHeader}" />

      <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Перемикач із профілю" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Записується у Profile одразу; зберігається при старті або там, де стара версія зберігала одразу." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding FastRolls, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon NumberSymbol24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Числове поле" Style="{StaticResource CardTitle}" />
            <TextBlock Text="ui:NumberBox з межами, кроком і підписом одиниць." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:NumberBox Width="160" Minimum="0" Maximum="5000" SmallChange="50" LargeChange="100" ClearButtonEnabled="False"
                      Value="{Binding ExitPauseMs, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Open24}" Margin="0,0,0,4">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Дія оболонки" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Команда викликає Shell.OpenSite; у прев'ю нічого не відкривається." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button Content="tunerfest.app/sets" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenSetsCommand}" />
      </ui:CardControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
