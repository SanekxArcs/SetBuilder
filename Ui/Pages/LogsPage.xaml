<UserControl x:Class="TunerFest.Ui.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TunerFest.Ui.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LogsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Text="{DynamicResource Loc0148}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{DynamicResource Loc0149}"
                 Style="{StaticResource CardDescription}" />

      <TextBlock Text="{DynamicResource Loc0160}" Style="{StaticResource SectionHeader}" />

      <ui:CardControl Icon="{ui:SymbolIcon DocumentBulletList24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc0172}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{DynamicResource Loc0473}" Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding DiagnosticsEnabled, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Screenshot24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc0173}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{DynamicResource Loc0213}" Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding DiagnosticScreenshots, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Storage24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc0244}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{DynamicResource Loc0177}"
                       Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:NumberBox Width="160" Minimum="1" Maximum="2048" SmallChange="64" LargeChange="256" ClearButtonEnabled="False"
                      Value="{Binding DiagnosticMaxMb, Mode=TwoWay}" />
      </ui:CardControl>

      <TextBlock Text="{DynamicResource Loc0339}" Style="{StaticResource SectionHeader}" />

      <Border Style="{StaticResource SettingsPanel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Margin="0,2,16,0" VerticalAlignment="Top"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{DynamicResource Loc0339}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{DynamicResource Loc0229}" Style="{StaticResource CardDescription}" />
          </StackPanel>
          <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left"
                      Text="{Binding FolderPath, Mode=OneWay}" ToolTip="{DynamicResource Loc0515}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="{DynamicResource Loc0084}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsCommand}" />
            <ui:Button Content="{DynamicResource Loc0458}" Icon="{ui:SymbolIcon FolderZip24}" Margin="8,0,0,0"
                       Command="{Binding ExportLogsCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="{DynamicResource Loc0162}"
                 Style="{StaticResource CardDescription}" Margin="2,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
