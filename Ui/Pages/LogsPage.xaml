<UserControl x:Class="TunerFest.Ui.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TunerFest.Ui.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LogsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Text="Журнали" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Журнали, статистика кидків і витрати зберігаються поруч із програмою. Кожен кидок записується один раз; записи кидків не обмежені лімітом скрінів."
                 Style="{StaticResource CardDescription}" />

      <TextBlock Text="Запис" Style="{StaticResource SectionHeader}" />

      <ui:CardControl Icon="{ui:SymbolIcon DocumentBulletList24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Зберігати журнал кожного запуску" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Текстовий журнал, сирий OCR і статистика кидків. Застосовується при старті." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding DiagnosticsEnabled, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Screenshot24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Зберігати скріни гри та проблемних зон" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Кадри з часовими мітками та вирізки зон, де розпізнавання не впевнене." Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding DiagnosticScreenshots, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Storage24}" Margin="0,0,0,4" IsEnabled="{Binding CanEdit}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Ліміт скрінів за один запуск, МБ" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Звичайні скріни: до 400 кадрів у межах ліміту. Останній безпечний кадр при помилці зберігається додатково. Текстовий журнал продовжується після вичерпання ліміту."
                       Style="{StaticResource CardDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:NumberBox Width="160" Minimum="1" Maximum="2048" SmallChange="64" LargeChange="256" ClearButtonEnabled="False"
                      Value="{Binding DiagnosticMaxMb, Mode=TwoWay}" />
      </ui:CardControl>

      <TextBlock Text="Папка журналів" Style="{StaticResource SectionHeader}" />

      <Border Style="{StaticResource SettingsPanel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Margin="0,2,16,0" VerticalAlignment="Top"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="Папка журналів" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Кожен запуск отримує власну підпапку; ZIP-архіви лягають у Logs\Archives." Style="{StaticResource CardDescription}" />
          </StackPanel>
          <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left"
                      Text="{Binding FolderPath, Mode=OneWay}" ToolTip="Шлях можна виділити й скопіювати" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="Відкрити папку Logs" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsCommand}" />
            <ui:Button Content="Створити ZIP останнього запуску" Icon="{ui:SymbolIcon FolderZip24}" Margin="8,0,0,0"
                       Command="{Binding ExportLogsCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="Записуються: версія і налаштування, кадри з часовими мітками, сирий OCR і повторні спроби, розпізнані відсотки, вибір варіанта, натискання та причина зупинки. Текст зберігається одразу; PNG — у фоні."
                 Style="{StaticResource CardDescription}" Margin="2,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
