<ui:FluentWindow x:Class="TunerFest.Ui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:TunerFest.Ui"
                 xmlns:controls="clr-namespace:TunerFest.Ui.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
                 Width="1180" Height="940" MinWidth="960" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 Icon="pack://application:,,,/Assets/app.ico">
  <ui:FluentWindow.Resources>
    <!-- Left navigation rows in the Windows 11 Settings look: icon, label, accent indicator on the selected row. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="36" Background="Transparent" ToolTip="{Binding Title}">
              <Border x:Name="Background" CornerRadius="4" Background="Transparent" />
              <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Margin="4,0,8,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                <Setter TargetName="Background" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavPane" TargetType="Border">
      <Setter Property="Width" Value="232" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
          <Setter Property="Width" Value="56" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CommandButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="130" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="LogRow" Height="220" MinHeight="130" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ui:TitleBar Grid.ColumnSpan="2" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowHelp="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- 1. Status card with the two main actions. -->
    <controls:StatusCard Grid.Row="1" Grid.ColumnSpan="2" Margin="24,8,24,0" DataContext="{Binding Status}">
      <controls:StatusCard.Actions>
        <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
          <ui:Button Content="Почати · F8" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Padding="14,6" MinWidth="150"
                     Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Margin="0,0,8,0"
                     AutomationProperties.Name="Почати · F8" />
          <ui:Button Content="Зупинити · F10" Icon="{ui:SymbolIcon Stop24}" Appearance="Secondary" Padding="14,6" MinWidth="150"
                     Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                     AutomationProperties.Name="Зупинити · F10" />
        </StackPanel>
      </controls:StatusCard.Actions>
    </controls:StatusCard>

    <!-- 2. Navigation pane (spans the content, splitter and log rows) and the selected page. -->
    <Border Grid.Row="2" Grid.RowSpan="3" Style="{StaticResource NavPane}" Margin="20,12,0,8">
      <DockPanel>
        <ui:Button DockPanel.Dock="Top" Appearance="Transparent" Padding="0" Width="40" Height="36" Margin="4,0,0,4"
                   HorizontalAlignment="Left" Icon="{ui:SymbolIcon LineHorizontal320}" Click="OnTogglePane"
                   ToolTip="Згорнути або розгорнути панель" AutomationProperties.Name="Панель навігації" />
        <ListBox x:Name="Nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Padding="0" Margin="4,0,8,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Cycle"
                 AutomationProperties.Name="Сторінки">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ItemsPresenter />
            </ControlTemplate>
          </ListBox.Template>
        </ListBox>
      </DockPanel>
    </Border>

    <ContentControl Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Content="{Binding SelectedPage.View}" Focusable="False" />

    <!-- 3. Run log below the content, resizable. -->
    <GridSplitter x:Name="LogSplitter" Grid.Row="3" Grid.Column="1" Height="8" Margin="24,0,24,0" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                  DragCompleted="OnLogSplitterDragCompleted" Focusable="False">
      <GridSplitter.Template>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="Transparent" Cursor="SizeNS">
            <Rectangle Width="44" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource ControlStrokeColorSecondaryBrush}" />
          </Grid>
        </ControlTemplate>
      </GridSplitter.Template>
    </GridSplitter>
    <controls:RunLog x:Name="Log" Grid.Row="4" Grid.Column="1" Margin="24,0,24,0" />

    <!-- 4. Command bar and status line. -->
    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="24,12,24,0">
      <ui:Button Style="{StaticResource CommandButton}" Content="Відкрити Logs" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsCommand}" />
      <ui:Button Style="{StaticResource CommandButton}" Content="ZIP останнього запуску" Icon="{ui:SymbolIcon FolderZip24}"
                 Command="{Binding ExportLogsCommand}" IsEnabled="{Binding CanExport}" />
      <ui:Button Style="{StaticResource CommandButton}" Content="tunerfest.app/sets ↗" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenSetsCommand}" />
      <ui:Button Style="{StaticResource CommandButton}" Content="Підтримка ↗" Icon="{ui:SymbolIcon QuestionCircle24}" Command="{Binding OpenSupportCommand}" />
    </StackPanel>
    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="26,6,24,12" FontSize="12" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Стан" />
  </Grid>
</ui:FluentWindow>
