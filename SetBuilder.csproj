<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.5.8</Version>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <AssemblyName>TunerFest Set Builder</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <Content Include="catalog.json;Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
